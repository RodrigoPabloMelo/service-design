{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Flutter: dependências no build (prototype/app/tool/vercel_build.sh)'",
  "buildCommand": "bash prototype/app/tool/vercel_build.sh",
  "outputDirectory": "prototype/app/build/web",
  "rewrites": [
    { "source": "/pitch", "destination": "/pitch/index.html" },
    { "source": "/pitch/", "destination": "/pitch/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
